// Kette Language
//
// the language is a prototype object based langague.
// everything is an object with unified syntax.
// a full object is written (each part is optional):
//
//   { slots | arguments | body }
//
// examples what it could look like coming from other languages:
//
//   { x: 1, y: 2 }              slots only
//   { |x| x + 1 }               function: arguments + body
//   { n: 0 |x| ... }            callable object
//   { }                         empty object
//   { || 0 }                    explicit zero-arg block
//
// Slots are defined with `:`:
//   name: value       named slot
//   [i]: value        element slot
//   name*: obj        parent slot (immutable)
// 
// Several `*` slots = multiple behavior inheritance, declaration order.
//
// Assignment uses `=` and only writes existing slots:
//   obj.x = v         write own named slot x, else error
//   obj[i] = v        write existing element i, else error (no growth)
// `=` never creates. `:` only appears in literals and Object.extend.
//
//
// Everything is a lookup + send. 

let obj = {
    parent*: Clonable
    x: 10
    y: 20
}

// the VM sees this as first a obj.lookup(x) and then an assign obj[offset] = 20
obj.x = 20

let inc = { |x| x + 1 }
inc(41)                 // 42 — sends inc.value(41)

let greet = { print("hi") }     // zero-arg: contents are statements,
greet.value()                   // not a slot list, so this is a block

let pair = { |a, b| { first: a, second: b } }
//          ^block         ^object: slot list, unambiguous even nested


let counter = {
    count: 0
    ||
        self.count = self.count + 1
        self.count
}

counter()               // 1
counter()               // 2


let func = { |o| print(o) }
func(obj)

// Methods are the same block, activated by a send.
// `self` is bound at send time. Illegal in a bare function.

// `+` is the message `add` with a symbolic spelling:
// 1 + 2 sends 1.add(2). Numbers are objects.


// Sends with special spelling 
//
//   a + b    add     a - b    sub     a * b    mul     a / b    div
//   a < b    lt      a > b    gt      a <= b   le      a >= b   ge
//   a == b   eq      a != b   ne
//
//   if c { A } else { B }    sends ifElse to c, with { A } and { B }


let sign = if n < 0 { -1 } else { 1 }


// Booleans 

let BooleanTraits = {
    parent*: Clonable
    ifElse: { |t, f| error("subclass responsibility") }
}

let TrueTraits = {
    parent*: BooleanTraits
    ifElse: { |t, f| t.value() }
    and:    { |b| b.value() }
    or:     { |b| self }
}

let FalseTraits = {
    parent*: BooleanTraits
    ifElse: { |t, f| f.value() }
    and:    { |b| self }
    or:     { |b| b.value() }
}

// --- Loops (prelude) ---

let BlockTraits = {
    parent*: Clonable
    whileTrue: { |body|
        if self.value() {
            body.value()
            self.whileTrue(body)
        }
    }
}

// An argument is a pattern.
//
//   x                    always matches, binds x
//   _                    always matches, binds nothing
//   42  "hi"             matches if v == the literal
//   [p, q]               length is 2, elements match p and q
//   [p, ...rest]         length >= 1, rest binds the remaining elements
//   { x: p, [0]: q }     v answers x (and element 0); their values
//                        match p and q
//   Proto { x: p }       Proto.unapply(v) — default: v.isChildOf(Proto),
//                        then destructure as above
//   Name(p)              Name.unapply(v), binds from p
//   pat if guard         after binding, the guard must hold
//
// Patterns nest: Box({ x: 0, y: y }) matches a Box whose x slot is 0
// and binds y.

let head = { | [a, ...rest] | a }
let norm = { | { x: a, y: b } | a * a + b * b }

// A block whose params might not match is a partial function.
// It answers two sends:
//
//   f.value(args...)   strict  — params must match, else CallTypeError
//   f.try(argsArray)   partial — Some(result) or None
//
// (try forwards the arguments through a small `apply` primitive and
// catches CallTypeError — one of the few true primitives.)

let five = { | 5 | "five" }
five.value(5)           // "five"
five.value(6)           // error: CallTypeError
five.try([6])           // None

// Guards evaluate after binding, in the block's scope:

let nonNeg = { | n if n >= 0 | n }
nonNeg.try([-2])        // None

let MaybeTraits = {
    parent*: Clonable
    ifSomeElse: { |f, g| g.value() }
    ifSome:     { |f| self }
    isNone:     { true }
}

let None = { parent*: MaybeTraits }

let SomeTraits = {
    parent*: MaybeTraits
    ifSomeElse: { |f, g| f.value(self.value) }
    ifSome:     { |f| f.value(self.value) }
    isNone:     { false }
}

let Some = { parent*: SomeTraits, value: null }

let s = Some.clone({ value: 41 })
s.ifSomeElse({ |v| v + 1 }, { 0 })      // 42


// match takes an array of blocks. The first arm whose params match the
// receiver runs; arms are tried in order. No match → MatchFailed.

shape.match([
    { | Circle { radius: r }   | area(r) }
    { | [a, b]                 | a + b   }
    { | Natural { value: n }   | n       }
    { | _                      | 0       }
])

// The whole implementation, on Object:

Clonable {
    // ...
    match: { |arms|
        let i = 0
        let result = None
        { (i < arms.length).and({ result.isNone }) }.whileTrue({
            result = arms[i].try([self])
            i = i + 1
        })
        result.ifSomeElse({ |v| v }, { MatchFailed.throw(self) })
    }  
}

let fib = firstDefined([
    { | 0 | 0 }
    { | 1 | 1 }
    { | n | fib(n - 1) + fib(n - 2) }
])

let abs = firstDefined([
    { | n if n < 0 | 0 - n }
    { | n          | n     }
])



let Vec2Traits = {
    parent*: Clonable

    new: { |x, y| Vec2.clone({ x: x, y: y }) }

    add: { |other|
        self.clone({
            x: self.x + other.x
            y: self.y + other.y
        })
    }
}

let Vec2 = {
    parent*: Vec2Traits
    x: 0
    y: 0
}

let a = Vec2.new(10, 20)
let b = Vec2.new(20, 20)
print(a + b)                // { x: 30, y: 40 }

// a.parent        -> Vec2Traits
// a.parent.parent -> Clonable



// Multiple parents

let ColorTraits = {
    parent*: Clonable
    describe: { self.color }
}

let ColoredVec2 = {
    parent*: Vec2Traits
    mixin*:  ColorTraits
    x: 0
    y: 0
    color: "red"
}

let c = ColoredVec2.clone({ x: 1, y: 2, color: "blue" })
print(c + b)
print(c.describe())         // "blue"

// obj.parent  -> Vec2Traits
// obj.mixin   -> ColorTraits
// obj.parents -> [Vec2Traits, ColorTraits]


// Arrays

let arr = [10, 20, 30]

// same as
// let arr = {
//     parent*: ArrayTraits
//     [0]: 10
//     [1]: 20
//     [2]: 30
// }

print(arr[0])               // 10
print(arr.0)                // 10    same element
print(arr.length)           // 3

arr[3] = 40                 // error: element 3 does not exist
arr.push(50)                // explicit grow via the library


// Object + array in one literal

let tuple = {
    parent*: ArrayTraits
    label: "pair"           // named
    [0]: 0                  // element
    [1]: 0
}

print(tuple[0])             // 0
print(tuple.0)              // 0
print(tuple.label)          // "pair"

tuple.label = "xy"          // ok
tuple.other = 1             // error
tuple[2] = 1                // error: element 2 does not exist

// Patterns see both stores too:
//   { | { label: "pair", [0]: x, [1]: y } | ... }


// objects can be extended:

Object.extend(a, "label", "origin")
print(a.label)

// Or several names:
Object.extend(a, { label: "origin", tag: 1 })