// Binary operators
// Run:  cargo run -q -p vm -- kette/kette_tests/operators.ktt
// Check: kette/kette_tests/check.py

Test.assert(1 + 2 * 3, 7)
Test.assert(10 - 3, 7)
Test.assert(3 - 10, -7)
Test.assert(5 % 3, 2)
Test.assert((10 - 3) % 4, 3)

Test.assert(1 < 2, true)
Test.assert(2 < 1, false)
Test.assert(2 <= 2, true)
Test.assert(3 > 2, true)
Test.assert(3 >= 3, true)
Test.assert(1 == 1, true)
Test.assert(1 != 2, true)
Test.assert(1 == 2, false)
Test.assert(1 != 1, false)

let x = 5
let y = 0 - x
Test.assert(-y, 5)
Test.assert(!(1 == 2), true)
